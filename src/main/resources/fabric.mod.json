{
	"schemaVersion": 1,
	"id": "karma-gate-mod",
	"version": "${version}",
	"name": "Karma Gate Mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/karma-gate-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.fouriis.karmagate.KarmaGateMod"
		],
		"client": [
			"dev.fouriis.karmagate.KarmaGateModClient",
			"dev.fouriis.karmagate.client.AtcCloudShaders",
			"dev.fouriis.karmagate.client.gridproject.GridProjectShaders",
			"dev.fouriis.karmagate.client.waterfall.WaterfallShaders",
			"dev.fouriis.karmagate.client.graffiti.GraffitiShaders"
		]
	},
	"mixins": [
		"karma-gate-mod.mixins.json",
		{
			"config": "karma-gate-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"librainworldmc": ">=1.0.3"
	},
	"suggests": {
		"another-mod": "*"
	}
}
